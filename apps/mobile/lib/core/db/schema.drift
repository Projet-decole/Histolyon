-- Base Drift unique du terminal (AD-4) : le serveur possède l'éditorial et le
-- communautaire, le terminal possède le Profil et les Parcours personnels
-- dans cette seule base locale (tables des Parcours personnels : à ajouter
-- avec leur feature). `id` en TEXT (uuid v4 généré côté client).
-- Les clés étrangères sont appliquées (PRAGMA foreign_keys dans
-- app_database.dart) : supprimer le Profil supprime ses données.

CREATE TABLE profil (
  id TEXT NOT NULL PRIMARY KEY,
  cree_le DATETIME NOT NULL
);

CREATE TABLE preference (
  profil_id TEXT NOT NULL REFERENCES profil(id) ON DELETE CASCADE,
  cle TEXT NOT NULL,
  valeur TEXT NOT NULL,
  PRIMARY KEY (profil_id, cle)
);

-- Favoris du Profil (C3). Local tant qu'aucun Compte n'ouvre la sync (I6).
-- type_de_cible : 'pin' | 'parcours' ; cible_id = uuid serveur.
CREATE TABLE favori (
  id TEXT NOT NULL PRIMARY KEY,
  profil_id TEXT NOT NULL REFERENCES profil(id) ON DELETE CASCADE,
  type_de_cible TEXT NOT NULL CHECK (type_de_cible IN ('pin', 'parcours')),
  cible_id TEXT NOT NULL,
  ajoute_le DATETIME NOT NULL,
  UNIQUE (profil_id, type_de_cible, cible_id)
);

-- Historique de visite (C3), local (I6). type_evenement :
-- consultation_pin | etape_visitee | parcours_engage | parcours_termine | resultat_quiz
CREATE TABLE historique_visite (
  id TEXT NOT NULL PRIMARY KEY,
  profil_id TEXT NOT NULL REFERENCES profil(id) ON DELETE CASCADE,
  type_evenement TEXT NOT NULL CHECK (type_evenement IN ('consultation_pin', 'etape_visitee', 'parcours_engage', 'parcours_termine', 'resultat_quiz')),
  type_de_cible TEXT NOT NULL CHECK (type_de_cible IN ('pin', 'parcours')),
  cible_id TEXT NOT NULL,
  horodatage DATETIME NOT NULL,
  duree_secondes INTEGER,
  score_quiz INTEGER
);

CREATE INDEX historique_visite_profil_horodatage ON historique_visite (profil_id, horodatage);
