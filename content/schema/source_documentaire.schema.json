{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "source_documentaire",
  "description": "Documente une affirmation d'un Pin (I4). Le crédit est obligatoire.",
  "required": [
    "id",
    "slug",
    "type",
    "reference",
    "credit",
    "created_at"
  ],
  "properties": {
    "id": {
      "default": "gen_random_uuid()",
      "description": "Note:\nThis is a Primary Key.<pk/>",
      "format": "uuid",
      "type": "string"
    },
    "slug": {
      "format": "text",
      "type": "string"
    },
    "type": {
      "format": "text",
      "type": "string"
    },
    "reference": {
      "format": "text",
      "type": "string"
    },
    "credit": {
      "format": "text",
      "type": "string"
    },
    "lien": {
      "format": "text",
      "type": "string"
    },
    "description": {
      "format": "text",
      "type": "string"
    },
    "created_at": {
      "default": "now()",
      "format": "timestamp with time zone",
      "type": "string"
    }
  },
  "type": "object"
}
