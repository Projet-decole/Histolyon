{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "categorie",
  "description": "Catalogue ouvert (I7) : addition libre, jamais d'archivage.",
  "required": [
    "id",
    "slug",
    "libelle",
    "ordre",
    "created_at"
  ],
  "properties": {
    "id": {
      "default": "gen_random_uuid()",
      "description": "Note:\nThis is a Primary Key.<pk/>",
      "format": "uuid",
      "type": "string"
    },
    "slug": {
      "format": "text",
      "type": "string"
    },
    "libelle": {
      "format": "text",
      "type": "string"
    },
    "description": {
      "format": "text",
      "type": "string"
    },
    "ordre": {
      "format": "int32",
      "type": "integer"
    },
    "created_at": {
      "default": "now()",
      "format": "timestamp with time zone",
      "type": "string"
    }
  },
  "type": "object"
}
