{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "epoque",
  "description": "Catalogue ouvert (I7). Bornes en années (négatif = avant J.-C.), simplification numérique de \"année ou expression de période\" (palier 4) pour piloter le slider.",
  "required": [
    "id",
    "slug",
    "libelle",
    "borne_debut",
    "borne_fin",
    "ordre",
    "created_at"
  ],
  "properties": {
    "id": {
      "default": "gen_random_uuid()",
      "description": "Note:\nThis is a Primary Key.<pk/>",
      "format": "uuid",
      "type": "string"
    },
    "slug": {
      "format": "text",
      "type": "string"
    },
    "libelle": {
      "format": "text",
      "type": "string"
    },
    "borne_debut": {
      "format": "int32",
      "type": "integer"
    },
    "borne_fin": {
      "format": "int32",
      "type": "integer"
    },
    "ordre": {
      "format": "int32",
      "type": "integer"
    },
    "created_at": {
      "default": "now()",
      "format": "timestamp with time zone",
      "type": "string"
    }
  },
  "type": "object"
}
