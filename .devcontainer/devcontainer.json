{
  "name": "HistoLyon",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Permet à `supabase start` (dans le conteneur) de piloter des conteneurs
  // Postgres/Auth/Storage sur le Docker de l'hôte, sans Docker-in-Docker.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [54321, 54322, 54323, 54324],
  "portsAttributes": {
    "54321": { "label": "Supabase API" },
    "54322": { "label": "Supabase DB (Postgres)" },
    "54323": { "label": "Supabase Studio" },
    "54324": { "label": "Supabase Inbucket (emails locaux)" }
  },
  "postCreateCommand": "flutter pub get && (lefthook install || true)",
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"]
    }
  },
  "remoteUser": "vscode"
}
